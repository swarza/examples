{
  "publicDir": "public",
  "redirects": [
    {
      "from": "/old/*",
      "to": "/:splat",
      "status": 301
    }
  ],
  "headers": [
    {
      "source": "/*",
      "headers": {
        "X-Frame-Options": "DENY"
      }
    },
    {
      "source": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ]
}
